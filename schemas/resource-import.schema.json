{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bndr:schema:resource-import:v1",
  "title": "BNDR Resource Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "append",
        "replace"
      ],
      "default": "append"
    },
    "confirmReplace": {
      "type": "boolean"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "backupVersion": {
      "type": "integer",
      "minimum": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "rowCount"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replace"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "confirmReplace": {
            "const": true
          }
        },
        "required": [
          "confirmReplace"
        ]
      }
    }
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "acronym": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "category": {
          "type": "string",
          "enum": [
            "child-abduction",
            "victim-rights-compensation",
            "domestic-violence-family-violence",
            "family-advocacy-trauma-recovery",
            "protective-parent-family-court",
            "gaslighting-darvo-institutional-betrayal",
            "parental-alienation-fathers-rights",
            "legal-aid-court-access",
            "attorneys-firms",
            "disability-medical-advocacy",
            "victim-linked-programs",
            "lyme-co-infections",
            "housing-financial-aid"
          ]
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "phoneRaw": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "tags": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        },
        "verified": {
          "type": "boolean",
          "default": false
        },
        "published": {
          "type": "boolean",
          "default": false
        },
        "sourceNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceCategory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "phoneNormalized": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "phoneDisplay": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "piipassAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "piipassNotes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        },
        "sourceDatasetHash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sourceRow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}

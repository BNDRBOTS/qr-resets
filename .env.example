# BNDR Resource Directory + QR Resets
# Default backend: Railway-local SQLite. No DATABASE_URL is required.
STORAGE_BACKEND=sqlite

# Railway production persistence:
# Attach a Railway Volume to this service, preferably mounted at /data.
# Railway automatically provides RAILWAY_VOLUME_MOUNT_PATH; do not hardcode it.
# Local development can optionally choose a data directory:
# BNDR_DATA_DIR=./data

# Single-admin login. ADMIN_PASSWORD_HASH is preferred; ADMIN_PASSWORD is a
# supported convenience fallback for Railway sealed variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Optional but required to use administrator recovery. On first credential
# bootstrap this is stored only as a one-way digest in the application database.
# Use a long, unique value (minimum 24 characters).
# ADMIN_RECOVERY_KEY=

# Optional. If omitted, the runtime creates stable secrets on the persistent
# Railway volume. You may provide your own instead.
# NEXTAUTH_SECRET=
# RATE_LIMIT_PEPPER=
# NEXTAUTH_URL=  # auto-derived from RAILWAY_PUBLIC_DOMAIN on Railway

# OPTIONAL POSTGRES / SUPABASE BACKEND
# Set BOTH values below to explicitly switch away from Railway-local SQLite.
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://...

# OPTIONAL STRIPE PAYMENT RAIL
# The directory, QR request flow, and admin backend work without these.
# Donation checkout buttons require payment URLs; webhook recording requires secret.
# NEXT_PUBLIC_QR_DONATE_MONTHLY_URL=
# NEXT_PUBLIC_QR_DONATE_ANNUAL_URL=
# NEXT_PUBLIC_QR_DONATE_CUSTOM_URL=
# NEXT_PUBLIC_QR_DONATE_SPONSOR_URL=
# STRIPE_WEBHOOK_SECRET=
